<style>
  :root{
    --court:#1E56C8;      /* azul césped de cancha */
    --court-deep:#123A8F;
    --ball:#D9F24B;       /* amarillo flúor pelota */
    --night:#0C1220;      /* pared de blindex de noche */
    --sand:#F2F0EA;
    --ink:#101828;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{font-family:'Space Grotesk',sans-serif;background:var(--sand);color:var(--ink)}
  h1,h2,.price,.tag{font-family:'Anton',sans-serif;letter-spacing:.5px}

  /* barra superior */
  nav{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;
      padding:14px 6vw;background:var(--night);color:#fff}
  .logo{font-family:'Anton',sans-serif;font-size:1.4rem;color:var(--ball)}
  .logo span{color:#fff}
  nav a.cta{background:var(--ball);color:var(--night);text-decoration:none;font-weight:700;
      padding:10px 18px;border-radius:999px;font-size:.9rem}

  /* hero con textura de grip */
  header{
    background:
      repeating-linear-gradient(-35deg, rgba(255,255,255,.045) 0 14px, transparent 14px 34px),
      linear-gradient(160deg, var(--court) 0%, var(--court-deep) 70%);
    color:#fff;padding:11vh 6vw 9vh;position:relative;overflow:hidden}
  header h1{font-size:clamp(2.6rem,7.5vw,5.4rem);line-height:.98;text-transform:uppercase;max-width:14ch}
  header h1 em{font-style:normal;color:var(--ball)}
  header p{margin-top:22px;max-width:46ch;font-size:1.05rem;color:#DCE6FF}
  .hero-actions{margin-top:34px;display:flex;gap:14px;flex-wrap:wrap}
  .btn{display:inline-block;text-decoration:none;font-weight:700;padding:15px 26px;border-radius:999px;font-size:1rem}
  .btn-ball{background:var(--ball);color:var(--night)}
  .btn-ghost{border:2px solid rgba(255,255,255,.5);color:#fff}
  .btn-ball:hover{transform:translateY(-2px)}
  .btn{transition:transform .15s ease}
  .ball{position:absolute;right:-60px;top:18%;width:280px;height:280px;border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #EEFF7A, #C7E01F 65%, #9DB50E);
    box-shadow:0 30px 60px rgba(0,0,0,.35);opacity:.9}
  .ball::after{content:"";position:absolute;inset:0;border-radius:50%;
    border:6px solid rgba(255,255,255,.55);clip-path:inset(0 0 0 52%)}
  @media(max-width:720px){.ball{width:150px;height:150px;right:-40px;top:8%}}

  /* franja marquesina */
  .strip{background:var(--ball);color:var(--night);font-family:'Anton',sans-serif;
    text-transform:uppercase;white-space:nowrap;overflow:hidden;padding:10px 0;font-size:1rem}
  .strip div{display:inline-block;animation:slide 18s linear infinite}
  @keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion: reduce){.strip div{animation:none}}

  section{padding:70px 6vw}
  .eyebrow{font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.18em;color:var(--court)}
  h2{font-size:clamp(1.9rem,4.5vw,3rem);text-transform:uppercase;margin:8px 0 36px}

  /* productos */
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:22px}
  .card{background:#fff;border-radius:18px;overflow:hidden;border:1px solid #E4E2DA;
    display:flex;flex-direction:column;transition:transform .15s ease,box-shadow .15s ease}
  .card:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(16,24,40,.12)}
  .thumb{height:150px;display:flex;align-items:center;justify-content:center;font-size:3.4rem;
    background:repeating-linear-gradient(-35deg,#EDF1FB 0 12px,#E2E9FA 12px 24px)}
  .card .body{padding:20px;display:flex;flex-direction:column;gap:8px;flex:1}
  .tag{display:inline-block;background:var(--night);color:var(--ball);font-size:.7rem;
    padding:4px 10px;border-radius:999px;width:max-content;text-transform:uppercase}
  .card h3{font-size:1.15rem}
  .card p{font-size:.9rem;color:#5A6472;flex:1}
  .price{font-size:1.5rem;color:var(--court-deep)}
  .price small{font-family:'Space Grotesk';font-size:.75rem;color:#8A93A2;font-weight:500}
  .buy{background:var(--court);color:#fff;text-align:center;text-decoration:none;
    padding:12px;border-radius:12px;font-weight:700}
  .buy:hover{background:var(--court-deep)}

  /* por qué */
  .why{background:var(--night);color:#fff}
  .why .eyebrow{color:var(--ball)}
  .why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:26px}
  .why-item{border-top:3px solid var(--ball);padding-top:16px}
  .why-item strong{display:block;font-size:1.05rem;margin-bottom:6px}
  .why-item p{color:#AAB4C6;font-size:.92rem}

  /* faq / envíos */
  .faq details{background:#fff;border:1px solid #E4E2DA;border-radius:14px;padding:18px 22px;margin-bottom:12px}
  .faq summary{font-weight:700;cursor:pointer}
  .faq p{margin-top:10px;color:#5A6472;font-size:.95rem}

  footer{background:var(--night);color:#8A93A2;padding:44px 6vw;font-size:.85rem;
    display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px}
  footer .logo{font-size:1.1rem}
  .wa-float{position:fixed;bottom:22px;right:22px;background:#25D366;color:#fff;width:58px;height:58px;
    border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.7rem;
    text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,.25);z-index:20}
  a:focus-visible,summary:focus-visible{outline:3px solid var(--court);outline-offset:3px}
</style>
</head>
